// Cloudflare Worker config for Forge v2 (see ../sow.md).
// FREE PLAN ONLY: every binding below is on the Workers Free plan. Do not add
// bindings that need Workers Paid (Queues, Email Sending, Containers, etc.).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forge",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forge-db",
      "database_id": "6b0b5bbc-0058-4287-9d53-d8dd8f5af2c5",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "forge-files" }],
  "ratelimits": [
    { "name": "AI_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1003", "simple": { "limit": 300, "period": 60 } }
  ],
  "vars": {
    "PBKDF2_ITERATIONS": "100000",
    "APP_ENV": "production",
    "PAYPAL_ENV": "live",
    "GEMINI_MODEL": "gemini-3.6-flash",
    "RESEND_FROM": "Forge <no-reply@send.forgeperformance.online>",
    "COACH_EMAIL": "kendenisdubai@gmail.com",
    "MIGRATION_ENABLED": "false",
    "SUPABASE_URL": "https://rjzfyfgymkcaffazzpff.supabase.co",
    "MAX_UPLOAD_BYTES": "10485760",
    "R2_SOFT_CAP_BYTES": "8589934592",
    "FILE_USER_DAILY_UPLOADS": "200",
    "FILE_GLOBAL_DAILY_UPLOADS": "3000"
  }
  // Secrets (wrangler secret put ...): GEMINI_API_KEY, FATSECRET_CLIENT_ID,
  // FATSECRET_CLIENT_SECRET, PAYPAL_CLIENT_ID, PAYPAL_SECRET, RESEND_API_KEY,
  // FILE_URL_SECRET, MIGRATION_ADMIN_TOKEN, SUPABASE_SERVICE_ROLE_KEY
}
